# Пароль от FTP — в репозиторий не попадает никогда
ftp.env

# Служебное: состояние синхронизации и копии прежних версий файлов
.ftpsync-manifest.json
backups/

# Видео. Git хранит каждую версию файла целиком и сжимать mp4 не умеет,
# поэтому ролики держим вне репозитория: они лежат на хостинге,
# а исходники — в папке «шкатулки» на рабочем столе.
*.mp4
*.mov
*.MOV

# Временные папки от подготовки картинок
_thumbs/
_check/
_check2/
_t2/
upload.zip

__pycache__/
