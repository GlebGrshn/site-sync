# Скопируй этот файл в ftp.env и заполни своими данными.
# Файл ftp.env никуда не отправляется и лежит только на твоём компьютере.

# Адрес сервера: домен сайта или IP из письма хостера
FTP_HOST=

# Порт FTP. Почти всегда 21 — меняй, только если хостер указал другой
FTP_PORT=21

# Логин FTP-пользователя (из ISPmanager -> FTP-пользователи)
FTP_USER=

# Пароль этого FTP-пользователя
FTP_PASS=

# 1 = пробовать шифрованное соединение FTPS (рекомендуется).
# Если сервер его не поддерживает, скрипт сам откатится на обычный FTP.
FTP_TLS=1

# Папка сайта на сервере.
# Если FTP-пользователь создан сразу для сайта, обычно достаточно /
# Иначе укажи полный путь, например: /var/www/builders/data/www/site.ru
REMOTE_ROOT=/

# Что не трогать при скачивании/заливке (через запятую, шаблоны в стиле *.log)
# Пример: EXCLUDE=*/uploads/*,*.zip,*.sql
EXCLUDE=
